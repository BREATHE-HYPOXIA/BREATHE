rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Water readings collection - public read, restricted write
    match /water_readings/{document=**} {
      // Allow anyone to read water quality data (public dashboard)
      allow read: if true;
      
      // Only allow writes from authenticated users or IoT devices with valid API keys
      // You'll need to validate the API key in your IoT device code
      allow write: if request.auth != null;
    }
    
    // Users collection - private by default
    match /users/{userId} {
      // Users can only read/write their own data
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    
    // System config (read-only for frontend)
    match /config/{document=**} {
      allow read: if true;
      allow write: if false; // Only write via backend or admin
    }
    
    // Deny all other access by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
